    <string name="help_display_settings"><b>Mga setting ng display:</b> Isausin ang mataas na kalidad, sharpness, two-page view, cover mode, at direksyon ng pagbabasa.</string>
    <string name="help_options"><b>Mga Opsyon:</b> I-access ang mga opsyon sa cover, i-reset ang mga setting, tulong, mga lisensya, at suporta.</string>
    <string name="help_document_info"><b>Impormasyon ng dokumento:</b> Tingnan ang mga metadata ng PDF tulad ng pamagat, may-akda, subtitle, mga keyword, at bersyon ng PDF.</string>
    <string name="help_help"><b>Tulong:</b> Basahin ang gabay na ito para sa mga tagubilin kung paano gamitin ang app.</string>
    <string name="help_app_info"><b>Impormasyon ng app:</b> Suriin ang bersyon ng app, build number, karapatang-ari, at mga badge ng suporta.</string>
    <string name="help_support"><b>Suportahan ang Developer:</b> Suportahan ang karagdagang pag-develop sa pamamagitan ng mga opsyonal na tip at tingnan ang iyong mga badge ng suporta.</string>
    <string name="help_high_quality"><b>Mataas na kalidad:</b> I-render ang mga pahina ng PDF sa mas mataas na kalidad.</string>
    <string name="help_sharpness"><b>Sharpness:</b> I-render ang text at mga linya nang mas malinaw.</string>
    <string name="help_two_page"><b>Two-page view:</b> Magpakita ng dalawang pahina nang magkatabi.</string>
    <string name="help_show_cover"><b>Ipakita ang cover:</b> Ipakita ang unang pahina nang nag-iisa bilang cover sa spread view.</string>
    <string name="help_reading_direction"><b>Direksyon ng pagbabasa:</b> Pumili kung ang mga pahina ay liliko mula kaliwa pakanan o pakanan kaliwa.</string>
    <string name="help_cover_mode"><b>Setting ng cover:</b> Pumili ng paglalagay ng cover para sa bawat direksyon ng pagbabasa.</string>
    <string name="help_reset"><b>I-reset:</b> I-reset ang mga setting ng app at isara ang kasalukuyang dokumento.</string>
