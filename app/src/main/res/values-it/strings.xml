    <string name="help_open"><b>Apri PDF:</b> Usa il selettore di file per scegliere un PDF dal dispositivo o dal cloud.</string>
    <string name="help_navigate"><b>Navigazione:</b> Cambia pagina scorrendo, usando il cursore o facendo clic sui bordi sinistro e destro nella modalità di navigazione con il mouse.</string>
    <string name="help_menu"><b>Menu:</b> Tocca lo schermo per mostrare o nascondere la barra degli strumenti e il cursore.</string>
    <string name="help_zoom"><b>Zoom:</b> Avvicina o allontana due dita per regolare lo zoom. Tieni premuto e trascina per spostare la pagina ingrandita.</string>
    <string name="help_search"><b>Ricerca:</b> Inserisci il testo nella barra di ricerca per trovare contenuti nel PDF.</string>
    <string name="help_layout"><b>Impostazioni:</b> Personalizza la visualizzazione e consulta le informazioni sul documento e sull’app.</string>
    <string name="help_high_quality"><b>Alta qualità:</b> Visualizza le pagine PDF con una qualità maggiore.</string>
    <string name="help_sharpness"><b>Nitidezza:</b> Rendi più nitidi il testo e le linee.</string>
    <string name="help_two_page"><b>Visualizzazione a due pagine:</b> Mostra due pagine affiancate.</string>
    <string name="help_show_cover"><b>Mostra copertina:</b> Mostra la prima pagina da sola come copertina nella visualizzazione a due pagine.</string>
    <string name="help_reading_direction"><b>Direzione di lettura:</b> Scegli se sfogliare le pagine da sinistra a destra o da destra a sinistra.</string>
    <string name="help_cover_mode"><b>Impostazione copertina:</b> Scegli la posizione della copertina per ogni direzione di lettura.</string>
    <string name="help_reset"><b>Ripristina:</b> Ripristina le impostazioni e chiudi il documento corrente.</string>
    <string name="help_display_settings"><b>Impostazioni di visualizzazione:</b> Regola qualità, nitidezza, visualizzazione a due pagine, copertina e direzione di lettura.</string>
    <string name="help_options"><b>Opzioni:</b> Accedi alle opzioni della copertina, al ripristino, alla guida, alle licenze e al supporto.</string>
    <string name="help_document_info"><b>Informazioni sul documento:</b> Consulta titolo, autore, sottotitolo, parole chiave e versione PDF.</string>
    <string name="help_help"><b>Aiuto:</b> Leggi questa guida per sapere come usare l’app.</string>
    <string name="help_app_info"><b>Informazioni sull’app:</b> Consulta versione, numero build, copyright e badge di supporto.</string>
    <string name="help_support"><b>Supporta lo sviluppo:</b> Contribuisci con una donazione facoltativa e consulta i tuoi badge di supporto.</string>
    <string name="help_slider"><b>Cursore delle pagine:</b> Trascina il cursore nella barra inferiore per passare a un’altra pagina.</string>
    <string name="privacy_policy">Informativa sulla privacy</string>
    <string name="privacy_policy_content" translatable="false">&lt;h2&gt;Informativa sulla privacy&lt;/h2&gt;&lt;p&gt;Lo sviluppatore di MihirakiPDFViewer rispetta la tua privacy.&lt;/p&gt;&lt;h3&gt;1. Raccolta e utilizzo&lt;/h3&gt;&lt;p&gt;L\'app non carica né raccoglie i tuoi file PDF. L\'elaborazione avviene localmente.&lt;/p&gt;&lt;h3&gt;2. Autorizzazioni&lt;/h3&gt;&lt;p&gt;L\'app utilizza lo Storage Access Framework (SAF).&lt;/p&gt;&lt;h3&gt;3. Sicurezza&lt;/h3&gt;&lt;p&gt;I tuoi dati rimangono sul tuo dispositivo.&lt;/p&gt;&lt;h3&gt;4. Contatti&lt;/h3&gt;&lt;p&gt;Contattaci tramite GitHub.&lt;/p&gt;</string>
